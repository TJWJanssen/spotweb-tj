# Copy to .env and adjust. DB_PASSWORD is required.
DB_PASSWORD=change-me
DB_NAME=spotweb
DB_USER=spotweb

# Port on the host, and PHP time zone
SPOTWEB_PORT=8080
PHP_TIMEZONE=Europe/Amsterdam

# Seconds between retrieve runs
RETRIEVE_INTERVAL=900

# Only needed when you serve Spotweb on a real domain name (leave empty for localhost)
SPOTWEB_COOKIE_HOST=

# Image to run (default: the one published by the GitHub workflow)
# SPOTWEB_IMAGE=ghcr.io/tjwjanssen/spotweb:security-hardening
